// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Product ──────────────────────────────────────────────────────────────────

enum ProductType {
  PHYSICAL    // Physical product to be shipped
  TRAINING    // Training course → sends Moodle access link after purchase
  DIGITAL     // Digital product → sends download link after purchase
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  description    String
  price          Decimal
  currency       String      @default("EUR")
  type           ProductType @default(PHYSICAL)
  images         String[]    // Array of image URLs
  stock          Int?        // null = unlimited (training, digital)
  active         Boolean     @default(true)
  moodleCourseId String?     // Moodle course ID if type = TRAINING

  orderItems     OrderItem[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([active])
}

// ─── Order ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING     // Payment initiated but not yet confirmed
  PAID        // Payment confirmed via webhook
  SHIPPED     // Physical product has been shipped
  DELIVERED   // Physical product has been delivered
  CANCELLED   // Order has been cancelled
  REFUNDED    // Order has been refunded
}

enum PaymentGateway {
  STRIPE
  FLUTTERWAVE
}

model Order {
  id                   String         @id @default(cuid())
  orderNumber          String         @unique // e.g. ORD-2024-0001

  // Customer information
  customerEmail        String
  customerLastName     String
  customerFirstName    String
  customerPhone        String?
  customerCountry      String         // ISO code e.g. FR, SN, CI

  // Shipping address (for physical products)
  addressLine1         String?
  addressLine2         String?
  addressCity          String?
  addressPostalCode    String?

  // Payment
  gateway              PaymentGateway
  paymentId            String?        // Stripe or Flutterwave transaction ID
  idempotencyKey       String         @unique // Prevents duplicate webhook processing
  totalAmount          Decimal
  currency             String         @default("EUR")

  status               OrderStatus    @default(PENDING)
  items                OrderItem[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@index([paymentId])
}

// ─── Order item ───────────────────────────────────────────────────────────────

model OrderItem {
  id           String   @id @default(cuid())
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String
  product      Product  @relation(fields: [productId], references: [id])
  productId    String
  quantity     Int      @default(1)
  unitPrice    Decimal  // Price snapshot at time of purchase
  productName  String   // Product name snapshot at time of purchase

  // Moodle access (if product type = TRAINING)
  moodleLinkSent     Boolean   @default(false)
  moodleLinkSentAt   DateTime?

  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
}
